# Copy this file to .env and add your own OpenAI API key.
OPENAI_API_KEY=replace_with_your_api_key

# Change the chat model here if your API project does not have access to this model.
OPENAI_MODEL=gpt-4.1-mini
NOVA_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
NOVA_TTS_MODEL=gpt-4o-mini-tts
NOVA_TTS_VOICE=marin
