# Cloud fallback and cloud speech transcription (optional)
OPENAI_API_KEY=
# Optional Google Gemini API key for Google Antigravity coding in Developer Studio.
# Keep this server-side only. Cloud source upload requires explicit per-task consent.
GEMINI_API_KEY=your_gemini_api_key_here

# AI routing: hybrid | local | cloud
LUNA_DEFAULT_MODE=hybrid
LUNA_TIMEZONE=Asia/Dubai
LUNA_LEAD_QUALIFIED_KEYWORDS=demo,pricing,quote,trial,consultation

# Local Ollama settings
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Cloud chat model
OPENAI_MODEL=gpt-4.1-mini
# Live voice transcription (Realtime WebRTC)
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin

# Local server — keep localhost-only
LUNA_HOST=127.0.0.1
LUNA_PORT=8765

# Audio upload limit in MB
MAX_AUDIO_MB=20

# Optional project folder for Developer Studio (default: workspace/projects)
# LUNA_PROJECTS_DIR=D:/LunaProjects
